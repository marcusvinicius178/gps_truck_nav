<?xml version="1.0"?>
<robot name="arocs_truck" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Material Definitions -->
<!-- Init colour -->
  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <material name="invisible">
    <color rgba="1.0 1.0 1.0 0.0"/>
  </material>


  <!-- Define robot constants -->
  <xacro:property name="base_width" value="2.548"/>
  <xacro:property name="base_length" value="9.605"/>
  <xacro:property name="base_height" value="0.877"/> <!-- Calculado na mão-->
  <xacro:property name="cabin_height" value="1.833"/>
  <xacro:property name="cabin_width" value="2.140" />
  <xacro:property name="cabin_length" value="1.964" />



  <xacro:property name="wheel_mass" value="74"/> <!-- given by manual: https://jipco.com.sa/wp-content/uploads/2020/11/Arocs_4542_B_51_Std.pdf-->
  <xacro:property name="wheel_radius" value="0.536"/> <!-- given by manual: https://jipco.com.sa/wp-content/uploads/2020/11/Arocs_4542_B_51_Std.pdf-->
  <!-- webiste converter Michelin: https://tire-calc.com/pt/comparison/385-65-r22.5-and-385-55-r22.5/-->
  <xacro:property name="wheel_width" value="0.385"/> 
  <xacro:property name="wheel_ygap" value="0.025"/>
  <xacro:property name="wheel_zoff" value="0.341"/> <!-- Calculado na mão-->
  <xacro:property name="wheel_xoff" value="3.302"/> <!-- First shaft, Frontal-->
  <xacro:property name="wheel2_xoff" value="1.552"/> <!-- Second Shaft, Frontal-->
  <xacro:property name="wheel3_xoff" value="-2.152"/> <!-- Third Shaft, Rear -->
  <xacro:property name="wheel4_xoff" value="-3.502"/> <!-- Fourth Shaft, Rear -->

  <!-- Define the frontal shaft bar size-->
  <xacro:property name="steering_bar_radius" value="0.0536"/>
  <xacro:property name="steering_bar_length" value="2.548"/>

  <!-- Define axles properties for the steering wheels (frontal)-->
  <xacro:property name="axle_length" value="0.20"/>
  <xacro:property name="axle_radius" value="0.1"/>

  <!-- Define lidar bar properties-->
  <xacro:property name="lidar_bar_length" value="0.93"/>
  <xacro:property name="lidar_bar_width" value="0.04"/>
  <xacro:property name="lidar_bar_width2" value="0.035"/>
  <xacro:property name="lidar_z_offset" value="0.1"/>


  <!-- Lidar Properties-->
  <xacro:property name="lidar_radius" value="0.065"/>
  <xacro:property name="lidar_height" value="0.075"/>

  <!-- GPS Properties-->
  <xacro:property name="gps_radius" value="0.08"/>
  <xacro:property name="gps_height" value="0.09"/>

  <!-- Radar Properties-->
  <xacro:property name="radar_length" value="0.05"/>
  <xacro:property name="radar_height" value="0.1"/>
  <xacro:property name="radar_width" value="0.15"/>

  <!-- Kinect Properties-->
  <xacro:property name="kinect_length" value="0.05"/>
  <xacro:property name="kinect_height" value="0.05"/>
  <xacro:property name="kinect_width" value="0.25"/>

  <!-- Camera Properties-->
  <xacro:property name="camera_radius" value="0.04"/>
  <xacro:property name="camera_height" value="0.09"/>

  <!-- 2D Lidar Properties-->
  <xacro:property name="sick_lidar_radius" value="0.08"/>
  <xacro:property name="sick_lidar_height" value="0.09"/>

    <!-- 2D Lidar Properties-->
  <xacro:property name="ultrasonic_radius" value="0.03"/>
  <xacro:property name="ultrasonic_length" value="0.05"/>


      <!-- Define inertial property macros -->
  <xacro:macro name="box_inertia" params="m w h d">
    <inertial>
      <origin xyz="0 0 0" rpy="${pi/2} 0 ${pi/2}"/>
      <mass value="${m}"/>
      <inertia ixx="${(m/12) * (h*h + d*d)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (w*w + d*d)}" iyz="0.0" izz="${(m/12) * (w*w + h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
     <origin xyz="0 0 0" rpy="0 0 0"/>
     <mass value="${m}"/>
     <inertia ixx="${(m/12) * (3*r*r + h*h)}" ixy="0.0" ixz="0.0" iyy="${(m/12) * (3*r*r + h*h)}" iyz="0.0" izz="${(m/2) * r*r}"/>
    </inertial>
  </xacro:macro>


    <!-- Robot Base -->
  <link name="base_link">
    <visual>
      <!-- <origin xyz="X_OFFSET Y_OFFSET Z_OFFSET" rpy="0 0 0"/> -->
      <geometry>
        <!-- <box size="${base_length} ${base_width} ${base_height}"/> -->
        <mesh filename="package://truck_bringup/models/arocs_truck/meshes/cabine_chassi.dae"/>
      </geometry>
      <material name="orange">
      </material>
    </visual>
    <xacro:box_inertia m="500" w="${base_width}" d="${base_length}" h="${base_height}"/>

  </link>

    <!-- Robot Footprint -->
  <link name="base_footprint"/>

<!--Robot Footprint Visualization-->  <xacro:property name="lidar_bar_length" value="0.93"/>

  <!-- <link name="base_footprint">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry> 
        <box size="${base_length} ${base_width} 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>  -->
  
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 ${(wheel_radius+wheel_zoff)}" rpy="0 0 0"/>
  </joint>

    <!-- Cabin -->
  <link name="cabin_link">
    <visual>
      <geometry>
        <box size="${cabin_length} ${cabin_width} ${cabin_height}"/>
      </geometry>
      <material name="invisible">
      </material>
      <!-- <material name="Green">
        <color rgba="0 1.0 0 1.0"/>
      </material> -->
    </visual>
    <!-- <collision>
      <geometry>
        <box size="${cabin_length} ${cabin_width} ${cabin_height}"/>
      </geometry>
    </collision> -->

    <xacro:box_inertia m="300" w="${cabin_width}" d="${cabin_length}" h="${cabin_height}"/>
  </link>

  <joint name="cabin_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cabin_link"/>
    <origin xyz="${base_length/2 - cabin_length/2} 0 ${wheel_zoff+base_height}" rpy="0 0 0"/>
  </joint>

  <link name="bar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.5"/> <!-- adjust mass as necessary -->
      <inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>

    <!-- <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width+ lidar_bar_length} ${lidar_bar_width} ${lidar_bar_width2}"/> 
    </collision> -->

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_width+lidar_bar_length} ${lidar_bar_width} ${lidar_bar_width2}"/> <!-- box size: length, width, height -->
      </geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="bar_to_cabin_joint" type="fixed">
    <parent link="cabin_link"/>
    <child link="bar_link"/>
    <origin xyz="${cabin_length/2 -0.1} 0 ${base_height + 0.7}" rpy="0 0 ${pi/2}"/> <!-- adjust height as necessary -->
  </joint>



   <!-- Bar Definition -->
  <xacro:macro name="horizontal_shaft" params="xpos ypos prefix_name ">
    <link name="${prefix_name}_horizontal_shaft_link">
      <visual>
        <geometry>
          <cylinder radius="${steering_bar_radius}" length="${steering_bar_length + wheel_ygap}"/>
        </geometry>
        <material name="green">
        </material>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${steering_bar_radius}" length="${steering_bar_length}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
      </collision>
      <xacro:cylinder_inertia m="1" r="${steering_bar_radius}" h="${steering_bar_length}"/>
    </link>
  </xacro:macro>

    <!-- Horizontal shafts instances -->
  <xacro:horizontal_shaft xpos="0" ypos="0" prefix_name="first_shaft" />
  <xacro:horizontal_shaft xpos="0" ypos="0" prefix_name="second_shaft" />
  <xacro:horizontal_shaft xpos="0" ypos="0" prefix_name="third_shaft" />
  <xacro:horizontal_shaft xpos="0" ypos="0" prefix_name="fourth_shaft" />

    <!-- Horizontal shaft to base link connection -->
  <xacro:macro name="horizontal_shaft_joint" params="prefix_name xpos ypos">
    <joint name="${prefix_name}_horizontal_shaft_joint" type="fixed">
      <parent link="base_link"/>
      <child link="${prefix_name}_horizontal_shaft_link"/>
      <origin xyz="${xpos} ${ypos} ${-wheel_zoff}" rpy="0 0 ${pi/2}"/>
      <axis xyz="0 0 1"/>
      <!-- <limit lower="-0.131" upper="0.131" effort="10000000" velocity="1000000"/> --> <!-- Just if change to revolute joint-->
    </joint>
  </xacro:macro>

  <xacro:horizontal_shaft_joint prefix_name="first_shaft" xpos="${wheel_xoff}" ypos="0" />
  <xacro:horizontal_shaft_joint prefix_name="second_shaft" xpos="${wheel2_xoff}" ypos="0" />
  <xacro:horizontal_shaft_joint prefix_name="third_shaft" xpos="${wheel3_xoff}" ypos="0" />
  <xacro:horizontal_shaft_joint prefix_name="fourth_shaft" xpos="${wheel4_xoff}" ypos="0" />

    <!-- Define Steering Axle Links -->
  <xacro:macro name="steer" params="prefix xpos ypos">
    <link name="${prefix}_steering_link">
      <visual>
        <geometry>
          <cylinder radius="${axle_radius}" length="${axle_length}"/>
        </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${axle_radius}" length="${axle_length}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia m="2" r="${axle_radius}" h="${axle_length}"/>
    </link>
  </xacro:macro>

  <!-- The Creation of the Steering Links must come before the joints definition, otherwise Rviz will show TF error-->
  <xacro:steer prefix="front_right" xpos="${-0.0001}" ypos="${0.0001}" />
  <xacro:steer prefix="front_left" xpos="${-0.0001}" ypos="${-0.0001}" />

    <!-- Define Steer Joint Macros-->
  <xacro:macro name="steer_joint" params="prefix xpos ypos">
    <joint name="${prefix}_steer_joint" type="revolute">
      <parent link="first_shaft_horizontal_shaft_link" />
      <child link="${prefix}_steering_link" />
      <origin xyz="${xpos} ${ypos} ${-0.001}" rpy="0 0 0" />
      <axis xyz="0 0 1" />
      <limit lower="-0.524" upper="0.524" effort="10000000" velocity="1000000" />
    </joint>
  </xacro:macro>

  <xacro:steer_joint prefix="front_left" xpos="${base_width/2 + wheel_ygap}" ypos="0" />
  <xacro:steer_joint prefix="front_right" xpos="-${base_width/2 + wheel_ygap}" ypos="0" />


    <!-- Wheels -->
  <xacro:macro name="wheel" params="prefix xpos ypos wheel_num geometry_type mesh_filename rpy material">
      <!-- Definir rpy padrão se não fornecido -->
      <xacro:property name="wheel_rpy" value="${rpy}" />
      <xacro:if value="${not wheel_rpy}">
          <xacro:property name="wheel_rpy" value="${pi/2} 0 0"/>
      </xacro:if>

      <!-- Calcular momentos de inércia -->
      <xacro:property name="ixx_iyy_inertia" value="10.629952"/>
      <xacro:property name="izz_inertia" value="21.259904"/>

      <link name="${prefix}_link">
      
      <!-- Visualização -->

          <visual>
              <origin xyz="0 0 0" rpy="${wheel_rpy}"/>
              <geometry>
                  <xacro:if value="${geometry_type == 'mesh'}">
                      <mesh filename="${mesh_filename}" scale="0.33 0.33 0.33"/>
                  </xacro:if>
                  <xacro:unless value="${geometry_type == 'mesh'}">
                      <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                  </xacro:unless>
              </geometry>
              <material name="${material}"/> <!-- Aplicando o material passado como parâmetro -->
          </visual>

        <!-- Inércia -->

          <inertial>
              <origin xyz="0 0 0" rpy="0 0 0"/>
              <mass value="${wheel_mass}"/>
              <inertia ixx="${ixx_iyy_inertia}" ixy="0" ixz="0" iyy="${ixx_iyy_inertia}" iyz="0" izz="${izz_inertia}"/>
          </inertial>

        <!-- Colisão (Sempre Cylinder) -->

          <collision>
              <origin xyz="0 0 0" rpy="${wheel_rpy}"/>
              <geometry>
                  <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
              </geometry>
                  <surface>
                      <friction>
                          <ode>
                              <mu>1.5</mu>
                              <mu2>1.5</mu2>
                              <kp>7000000.0</kp>
                              <kd>3.0</kd>
                              <fdir1>1 0 0</fdir1>
                              <slip1>0.0</slip1>
                              <slip2>0.0</slip2>
                          </ode>
                      </friction>
                  </surface>
          </collision>
      </link>

      <!-- Definir Juntas -->
      <xacro:if value="${wheel_num == 1 or wheel_num == 4}">
          <!-- Rodas de Steering (1 e 4) -->
          <joint name="${prefix}_joint" type="continuous">
              <xacro:if value="${prefix == 'first_wheel_left' or prefix == 'first_wheel_right'}">
                  <parent link="front_${prefix[12:]}_steering_link"/>
                  <origin xyz="${xpos} ${ypos} 0" rpy="0 0 1.57"/>
              </xacro:if>
              <xacro:unless value="${prefix == 'first_wheel_left' or prefix == 'first_wheel_right'}">
                  <parent link="fourth_shaft_horizontal_shaft_link"/>
                  <origin xyz="${xpos} ${ypos} 0" rpy="0 0 1.57"/>
              </xacro:unless>
              <child link="${prefix}_link"/>
              <axis xyz="0 -1 0"/>
          </joint>
      </xacro:if>
      <xacro:unless value="${wheel_num == 1 or wheel_num == 4}">
          <!-- Rodas Fixas (2 e 3) -->
          <joint name="${prefix}_joint" type="fixed">
              <parent link="${'second_shaft_horizontal_shaft_link' if 'second' in prefix else 'third_shaft_horizontal_shaft_link'}"/>
              <child link="${prefix}_link"/>
              <origin xyz="${xpos} ${ypos} 0" rpy="0 0 1.57"/>
          </joint>
      </xacro:unless>
  </xacro:macro>



<!-- Rodas de Steering com Geometria Variada -->
  <!-- Roda Frontal Esquerda com Malha e Rotação de 90 Graus Horário -->
  <xacro:wheel 
      prefix="first_wheel_left" 
      xpos="0" 
      ypos="0" 
      wheel_num="1" 
      geometry_type="mesh" 
      mesh_filename="package://truck_bringup/models/arocs_truck/meshes/roda_frontal_esquerda.dae"
      rpy="1.570796 0 0"
      material="black"/> <!-- Aplicando cor preta -->

<!-- Roda Frontal Direita com Geometria Primitiva -->
  <xacro:wheel 
      prefix="first_wheel_right" 
      xpos="0" 
      ypos="-0.025" 
      wheel_num="1" 
      geometry_type="mesh" 
      mesh_filename="package://truck_bringup/models/arocs_truck/meshes/roda_frontal_direita.dae"
      rpy="1.570796 0 0"
      material="black"/> <!-- Aplicando cor preta -->

  <!-- Rodas Fixas com Geometria Primitiva -->
  <xacro:wheel 
      prefix="second_wheel_left" 
      xpos="${base_width/2 + wheel_ygap}" 
      ypos="0" 
      wheel_num="2" 
      geometry_type="mesh" 
      mesh_filename="package://truck_bringup/models/arocs_truck/meshes/roda_frontal_esquerda.dae" 
      rpy="1.570796 0 0"
      material="grey"/> <!-- Aplicando cor cinza -->

  <xacro:wheel 
      prefix="second_wheel_right" 
      xpos="-${base_width/2 + wheel_ygap}" 
      ypos="0" 
      wheel_num="2" 
      geometry_type="mesh" 
      mesh_filename="package://truck_bringup/models/arocs_truck/meshes/roda_frontal_direita.dae" 
      rpy="1.570796 0 0"
      material="grey"/> <!-- Aplicando cor cinza -->

  <xacro:wheel 
      prefix="third_wheel_left" 
      xpos="${base_width/2 + wheel_ygap}" 
      ypos="0" 
      wheel_num="3" 
      geometry_type="mesh" 
      mesh_filename="package://truck_bringup/models/arocs_truck/meshes/roda_traseira_esquerda.dae" 
      rpy="1.570796 0 0"
      material="grey"/> <!-- Aplicando cor cinza -->

  <xacro:wheel 
      prefix="third_wheel_right" 
      xpos="-${base_width/2 + wheel_ygap}" 
      ypos="0" 
      wheel_num="3" 
      geometry_type="mesh" 
      mesh_filename="package://truck_bringup/models/arocs_truck/meshes/roda_traseira_direita.dae" 
      rpy="1.570796 0 0"
      material="grey"/> <!-- Aplicando cor cinza -->

  <xacro:wheel 
      prefix="fourth_wheel_left" 
      xpos="${base_width/2 + wheel_ygap}" 
      ypos="0" 
      wheel_num="4" 
      geometry_type="mesh" 
      mesh_filename="package://truck_bringup/models/arocs_truck/meshes/roda_traseira_esquerda.dae" 
      rpy="1.570796 0 0"
      material="black"/> <!-- Aplicando cor preta -->

  <xacro:wheel 
      prefix="fourth_wheel_right" 
      xpos="-${base_width/2 + wheel_ygap}" 
      ypos="0" 
      wheel_num="4" 
      geometry_type="mesh" 
      mesh_filename="package://truck_bringup/models/arocs_truck/meshes/roda_traseira_direita.dae" 
      rpy="1.570796 0 0"
      material="black"/> <!-- Aplicando cor preta -->


<!--Sensors -->
  <!-- Imu Link-->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.25 0.25 0.25"/>
      </geometry>
      <material name="grey"/>
    </visual>

    <!-- <collision>
      <geometry>
        <box size="0.25 0.25 0.25"/>
      </geometry>
    </collision> -->

    <xacro:box_inertia m="0.1" w="0.1" d="0.1" h="0.1"/>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="cabin_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.1 0 0.5" rpy="0.0 0.0 0.0"/>
  </joint>

<!-- Lidar-->
  <!--Lidar Link-->
  <link name="right_lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name= "lidar_to_support_link" type="fixed">
    <parent link="bar_link"/>
    <child link="right_lidar_link"/>
    <origin xyz="-${base_width/2 + lidar_bar_length/2 -lidar_radius} ${0} -${lidar_bar_width/2 + lidar_height/2 + lidar_z_offset}" rpy="${pi/36} 0 0"/>
  </joint>


  <link name="left_lidar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${lidar_radius}" length="${lidar_height}"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name= "left_lidar_to_support_link" type="fixed">
    <parent link="bar_link"/>
    <child link="left_lidar_link"/>
    <origin xyz="${base_width/2 + lidar_bar_length/2 - lidar_radius} ${0} -${lidar_bar_width/2 + lidar_height/2 + lidar_z_offset}" rpy="${pi/36} 0 0"/>
  </joint>

      <!-- SICK 2D Lidar -->

  <link name="cloud">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${sick_lidar_radius}" length="${sick_lidar_height}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${sick_lidar_radius}" length="${sick_lidar_height}"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>

  <joint name="sick_joint" type="fixed">
      <origin xyz="${0.05 + base_length/2} 0 ${base_height/4}" rpy="0 0 0"/>
      <!-- <origin xyz="-${base_length/3} 0 ${base_height/2 + sick_lidar_height}" rpy="0 0 3.14159"/> -->
      <parent link="base_link"/>
      <child link="cloud"/>
  </joint>


    <!-- CAMERA BLACKFLY FLIR -->

  <link name="camera_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${camera_radius}" length="${camera_height}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${camera_radius}" length="${camera_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="camera_joint" type="fixed">
      <origin xyz="${cabin_length/2+camera_height} 0 ${base_height/8}" rpy="${pi} ${pi/2} ${pi}"/>
      <parent link="cabin_link"/>
      <child link="camera_link"/>
  </joint>

  <link name="camera_change_orientation_view"/>

  <joint name="camera_depth_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 ${pi + pi/2} 0"/>
    <parent link="camera_link"/>
    <child link="camera_change_orientation_view"/>
  </joint>



  <!-- GPS NavSat standard-->

  <link name="gps_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${gps_radius}" length="${gps_height}"/>
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${gps_radius}" length="${gps_height}"/>
      </geometry>
      <material name="light_black"/>
    </visual>
  </link>

  <joint name="gps_joint" type="fixed">
      <origin xyz="0 0 ${gps_height+base_height}" rpy="0 0 0"/>
      <parent link="cabin_link"/>
      <child link="gps_link"/>
  </joint>


  <!-- Radar standard-->

  <link name="radar_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001"  ixy="0"  ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <!-- <box size="0.25 0.25 0.25"/> -->
        <box size="${radar_length} ${radar_width} ${radar_height}" />
      </geometry>
    </collision>

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size ="${radar_length} ${radar_width} ${radar_height}" />
      </geometry>
      <material name="light_black"/>
    </visual>
  </link>

  <joint name="radar_joint" type="fixed">
      <origin xyz="${base_length/2} 0 ${base_height/4}" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="radar_link"/>
  </joint>

  <!-- Ultrassonic Sensors-->

