  <!-- Aplicando cor preta -->
  <link name="fourth_wheel_right_link">
    <!-- Visualização -->
    <visual>
      <origin rpy="1.570796 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://truck_bringup/models/arocs_truck/meshes/roda_traseira_direita.dae" scale="0.33 0.33 0.33"/>
      </geometry>
      <material name="black"/>
      <!-- Aplicando o material passado como parâmetro -->
    </visual>
    <!-- Inércia -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="74"/>
      <inertia ixx="10.629952" ixy="0" ixz="0" iyy="10.629952" iyz="0" izz="21.259904"/>
    </inertial>
    <!-- Colisão (Sempre Cylinder) -->
    <collision>
      <origin rpy="1.570796 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.385" radius="0.536"/>
      </geometry>
      <surface>
        <friction>
          <ode>
            <mu>1.5</mu>
            <mu2>1.5</mu2>
            <kp>7000000.0</kp>
            <kd>3.0</kd>
            <fdir1>1 0 0</fdir1>
            <slip1>0.0</slip1>
            <slip2>0.0</slip2>
          </ode>
        </friction>
      </surface>
    </collision>
  </link>
  <!-- Rodas de Steering (1 e 4) -->
  <joint name="fourth_wheel_right_joint" type="continuous">
    <parent link="fourth_shaft_horizontal_shaft_link"/>
    <origin rpy="0 0 1.57" xyz="-1.299 0 0"/>
    <child link="fourth_wheel_right_link"/>
    <axis xyz="0 -1 0"/>
  </joint>
  <!-- Aplicando cor preta -->
  <!--Sensors -->
  <!-- Imu Link-->
  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.25 0.25 0.25"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <!-- <collision>
      <geometry>
        <box size="0.25 0.25 0.25"/>
      </geometry>
    </collision> -->
    <inertial>
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.0001666666666666667" ixy="0.0" ixz="0.0" iyy="0.0001666666666666667" iyz="0.0" izz="0.0001666666666666667"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="cabin_link"/>
    <child link="imu_link"/>
    <origin rpy="0.0 0.0 0.0" xyz="-0.1 0 0.5"/>
  </joint>
  <!-- Lidar-->
  <!--Lidar Link-->
  <link name="right_lidar_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.075" radius="0.065"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.075" radius="0.065"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="lidar_to_support_link" type="fixed">
    <parent link="bar_link"/>
    <child link="right_lidar_link"/>
    <origin rpy="0.08726646259971647 0 0" xyz="-1.6740000000000002 0 -0.1575"/>
  </joint>
  <link name="left_lidar_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.075" radius="0.065"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.075" radius="0.065"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="left_lidar_to_support_link" type="fixed">
    <parent link="bar_link"/>
    <child link="left_lidar_link"/>
    <origin rpy="0.08726646259971647 0 0" xyz="1.6740000000000002 0 -0.1575"/>
  </joint>
  <!-- SICK 2D Lidar -->
  <link name="cloud">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.09" radius="0.08"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.09" radius="0.08"/>
      </geometry>
      <material name="red"/>
    </visual>
  </link>
  <joint name="sick_joint" type="fixed">
    <origin rpy="0 0 0" xyz="4.8525 0 0.21925"/>
    <!-- <origin xyz="-${base_length/3} 0 ${base_height/2 + sick_lidar_height}" rpy="0 0 3.14159"/> -->
    <parent link="base_link"/>
    <child link="cloud"/>
  </joint>
  <!-- CAMERA BLACKFLY FLIR -->
  <link name="camera_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.09" radius="0.04"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.09" radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <origin rpy="3.141592653589793 1.5707963267948966 3.141592653589793" xyz="1.072 0 0.109625"/>
    <parent link="cabin_link"/>
    <child link="camera_link"/>
  </joint>
  <link name="camera_change_orientation_view"/>
  <joint name="camera_depth_joint" type="fixed">
    <origin rpy="0 4.71238898038469 0" xyz="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_change_orientation_view"/>
  </joint>
  <!-- GPS NavSat standard-->
  <link name="gps_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.09" radius="0.08"/>
      </geometry>
    </collision>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder length="0.09" radius="0.08"/>
      </geometry>
      <material name="light_black"/>
    </visual>
  </link>
  <joint name="gps_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.967"/>
    <parent link="cabin_link"/>
    <child link="gps_link"/>
  </joint>
  <!-- Radar standard-->
  <link name="radar_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1.25"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
