  <!-- GAZEBO PLUGINS FOR SENSORS -->
  <!-- IMU -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin">
        <ros>
          <!-- <namespace>/demo</namespace> -->
          <remapping>~/out:=imu</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>
  <!-- 3D Velodyne LiDAR Sensor -->
  <gazebo reference="right_lidar_link">
    <sensor name="right_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <!-- Calculated in the same rate of turtlebot example which the min range is = 3.5% of the max range-->
          <max>100.0</max>
          <!-- MAximum range of VLP 16 is 100 meters-->
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="right_lidar_scan">
        <ros>
          <remapping>~/out:=right_scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>right_lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo reference="left_lidar_link">
    <sensor name="left_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1.000000</resolution>
            <min_angle>0.000000</min_angle>
            <max_angle>6.280000</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>100.0</max>
          <resolution>0.015000</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="left_lidar_scan">
        <ros>
          <remapping>~/out:=left_scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>left_lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
  <!-- SICK 2D Lidar -->
  <gazebo reference="cloud">
    <sensor name="sick_lidar" type="ray">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <!-- Number of rays cast per scan -->
            <resolution>1.00000</resolution>
            <!-- Angular resolution in degrees -->
            <min_angle>-1.570796</min_angle>
            <!-- Start angle of the scan, -90 degrees -->
            <max_angle>1.570796</max_angle>
            <!-- End angle of the scan, 90 degrees -->
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <!-- Minimum range value -->
          <max>40.0</max>
          <!-- Maximum range value -->
          <resolution>0.01</resolution>
          <!-- Range resolution -->
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin filename="libgazebo_ros_ray_sensor.so" name="scan_link_lidar">
        <ros>
          <remapping>~/out:=/sick_scan_2D</remapping>
          <!-- Topic to publish the scan data -->
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>cloud</frame_name>
        <!-- Frame ID for the sensor data -->
      </plugin>
    </sensor>
  </gazebo>
  <!-- GPS -->
  <!-- GPS Sensor -->
  <gazebo reference="gps_link">
    <sensor name="arocs_gps" type="gps">
      <always_on>true</always_on>
      <update_rate>1</update_rate>
      <plugin filename="libgazebo_ros_gps_sensor.so" name="gps_plugin">
        <ros>
          <namespace>/gps</namespace>
          <remapping>~/out:=fix</remapping>
          <remapping>~/out:=data</remapping>
          <remapping>~/vel:=velocity</remapping>
        </ros>
      </plugin>
    </sensor>
  </gazebo>
  <!-- RADAR -->
  <!-- <gazebo reference="radar_link">
    <sensor type="ray" name="radar">
      <pose>0 0 0 0 0 0</pose>
      <always_on>true</always_on>
