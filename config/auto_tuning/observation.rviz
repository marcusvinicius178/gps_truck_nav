Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Alpha: 0.25
      Cell Size: 1
      Plane Cell Count: 80
      Reference Frame: base_footprint
      Color: 150; 150; 150
    - Class: rviz_default_plugins/RobotModel
      Name: Mercedes Arocs
      Enabled: true
      Alpha: 1
      Collision Enabled: false
      Visual Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/TF
      Name: Navigation and sensor frames
      Enabled: true
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 0.5
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        base_footprint:
          Value: true
        base_link:
          Value: true
        gps_link:
          Value: true
        imu_link:
          Value: true
    - Class: rviz_default_plugins/LaserScan
      Name: Sick scan
      Enabled: true
      Topic:
        Value: /sick_scan_2D
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 70; 70
      Size (Pixels): 4
      Style: Points
    - Class: rviz_default_plugins/Map
      Name: Global rolling costmap
      Enabled: true
      Alpha: 0.35
      Color Scheme: costmap
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Update Topic:
        Value: /global_costmap/costmap_updates
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: Local rolling costmap
      Enabled: true
      Alpha: 0.45
      Color Scheme: costmap
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
      Update Topic:
        Value: /local_costmap/costmap_updates
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Polygon
      Name: Truck footprint
      Enabled: true
      Alpha: 1
      Color: 40; 255; 90
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Odometry
      Name: Global pose
      Enabled: true
      Keep: 1
      Position Tolerance: 0
      Angle Tolerance: 0
      Topic:
        Value: /odometry/global
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Planned path (empty before authorized planning)
      Enabled: true
      Line Style: Lines
      Line Width: 0.15
      Color: 255; 210; 30
      Topic:
        Value: /plan
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: MPPI transformed global plan (conditional on visualize)
      Enabled: true
      Line Style: Lines
      Line Width: 0.1
      Color: 30; 180; 255
      Topic:
        Value: /transformed_global_plan
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: MPPI trajectories (conditional on visualize)
      Enabled: true
      Topic:
        Value: /trajectories
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 35; 45; 55
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools: []
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Truck observation
      Distance: 45
      Pitch: 0.6
      Yaw: 0.8
      Target Frame: base_footprint
      Focal Point:
        X: 0
        Y: 0
        Z: 1.5
      Near Clip Distance: 0.01
Window Geometry:
  Height: 900
  Width: 1100
  X: 1100
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: true
